PORT=3001
# Origen permitido por CORS. Con Ruta B (Vercel + túnel): https://<tu-proyecto>.vercel.app
# Para trabajo 100% local: https://www.rutabol.test
FRONTEND_ORIGIN=https://<tu-proyecto>.vercel.app
DATABASE_URL=postgresql://micros:PASSWORD@localhost:5433/micros_scz
SESSION_SECRET=cambiar-por-una-clave-aleatoria-de-32-caracteres-minimo
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar-por-contrasena-de-laboratorio
# Contraseña compartida de los usuarios de demostración (mínimo 12 caracteres)
RUTABOL_DEMO_PASSWORD=cambiar-por-contrasena-demo-minimo-12-caracteres
# Ruta B: cookies cross-site. Requiere el parche descrito en GUIA_PASO6_TUNEL.md
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Extra: pasarela Stripe en modo de prueba.
# Por defecto PAGOS_MODO=SIMULADO y la demo funciona sin internet ni credenciales.
# Para activar Stripe, cargá una clave de prueba y reiniciá la API:
# PAGOS_MODO=STRIPE
# STRIPE_SECRET_KEY=sk_test_...
# El importe en Bs se convierte a la moneda de la pasarela con esta tasa (1 = mismo número).
# STRIPE_MONEDA=usd
# STRIPE_TIPO_CAMBIO=1
# URLs de retorno (la de éxito debe conservar el placeholder de sesión):
# STRIPE_SUCCESS_URL=https://www.rutabol.test/#pasajero?pago=stripe&session_id={CHECKOUT_SESSION_ID}
# STRIPE_CANCEL_URL=https://www.rutabol.test/#pasajero?pago=cancelado
# Solo si configurás un webhook público con el CLI de Stripe:
# STRIPE_WEBHOOK_SECRET=whsec_...

# Extra: notificaciones externas (Web Push y correo). Todo es opcional.
# Estado de entrega: push sin claves y correo DESACTIVADO a propósito.
# Qué falta para producción y cómo configurarlo: MANUAL.md, sección 9.7.
# Generá las claves VAPID con: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:demo@rutabol.test
# Para el correo, ARCHIVO escribe .eml en backend/uploads/correos (sin credenciales).
# SMTP usa los datos siguientes; DESACTIVADO es el valor por defecto.
# NOTIFICACIONES_EMAIL_MODO=DESACTIVADO
# NOTIFICACIONES_EMAIL_DESTINO=demo@rutabol.test
# SMTP_HOST=...
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=...
# SMTP_PASSWORD=...