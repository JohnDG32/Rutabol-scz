$TTL 3600
@   IN  SOA ns1.rutabol.test. hostmaster.rutabol.test. (
        2026112001 ; serial
        3600       ; refresh
        900        ; retry
        604800     ; expire
        300        ; negative cache
)

@       IN  NS  ns1.rutabol.test.
ns1     IN  A   127.0.0.1
@       IN  A   127.0.0.1
www     IN  A   127.0.0.1
api     IN  A   127.0.0.1